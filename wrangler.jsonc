{
  // Cloudflare Workers にそのままデプロイできる設定。
  // D1 などの事前作成リソースは不要 (DO はデプロイ時に自動作成される)。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bomb-pass",
  "main": "src/index.ts",
  "compatibility_date": "2025-07-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomDO" },
      { "name": "LOBBY", "class_name": "LobbyDO" }
    ]
  },
  // 通算戦績・ランキングを使うときだけ D1 を接続する (未設定でもゲームは動く)。
  // 下の database_id を自分の D1 の ID に置き換えてコメントを外す:
  // "d1_databases": [
  //   { "binding": "DB", "database_name": "bakudance", "database_id": "<YOUR_D1_ID>" }
  // ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDO"] },
    { "tag": "v2", "new_sqlite_classes": ["LobbyDO"] }
  ],
  "observability": { "enabled": true }
}
