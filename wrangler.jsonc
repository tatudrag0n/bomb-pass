{
  // Cloudflare Workers にそのままデプロイできる設定。
  // D1 などの事前作成リソースは不要 (DO はデプロイ時に自動作成される)。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bomb-pass",
  "main": "src/index.ts",
  "compatibility_date": "2025-07-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomDO" }]
  },
  // 通算戦績・ランキングを使うときだけ D1 を接続する (未設定でもゲームは動く)。
  "d1_databases": [
    { "binding": "DB", "database_name": "bakudance", "database_id": "1ec282c6-eea1-47ef-a46b-b0979fa1f9c3" }
  ],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }],
  "observability": { "enabled": true }
}
