{
  // Cloudflare Workers にそのままデプロイできる設定。
  // Durable Objects はデプロイ時に自動作成される。D1 (bakudance) だけは作成済みのものを参照する。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bakudance",
  "main": "src/index.ts",
  "compatibility_date": "2025-07-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomDO" },
      { "name": "LOBBY", "class_name": "LobbyDO" }
    ]
  },
  // 通算戦績・ランキング用の D1。テーブルは初回アクセス時に自動作成される。
  "d1_databases": [
    { "binding": "DB", "database_name": "bakudance", "database_id": "1ec282c6-eea1-47ef-a46b-b0979fa1f9c3" }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDO"] },
    { "tag": "v2", "new_sqlite_classes": ["LobbyDO"] }
  ],
  "observability": { "enabled": true }
}
